@using AliMartinCv.Core.ViewModels.Project
@model List<ProjectDto>

@{
    Layout = "/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<style>
    .project-thumbnail {
        width: 90px;
        height: 65px;
        object-fit: cover;
        border: 1px solid #e9ecef;
    }

    .project-description {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        max-width: 450px;
    }

    .table > :not(caption) > * > * {
        padding: 1rem;
    }

    .table tbody tr {
        transition: background-color 0.2s ease;
    }

        .table tbody tr:last-child td {
            border-bottom: 0;
        }

    @@media (max-width: 768px) {
        .project-thumbnail {
            width: 70px;
            height: 55px;
        }

        .project-description {
            min-width: 220px;
        }
    }
</style>
<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">مدیریت پروژه‌ها</h4>
            <small class="text-muted">
                لیست پروژه‌های ثبت‌شده
            </small>
        </div>

        <a class="btn btn-success px-4"
           asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i>
            افزودن پروژه
        </a>
    </div>


    <!-- Projects Card -->
    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="text-center py-3">
                                    تصویر
                                </th>

                                <th class="py-3">
                                    عنوان
                                </th>

                                <th class="py-3">
                                    توضیحات کوتاه
                                </th>

                                <th class="text-center py-3">
                                    عملیات
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var project in Model)
                            {
                                <tr>

                                    <!-- Thumbnail -->
                                    <td class="text-center">
                                        <img src="/Images/projects/@project.Thumbnail"
                                             alt="@project.Title"
                                             class="project-thumbnail rounded-3"
                                             loading="lazy" />
                                    </td>


                                    <!-- Title -->
                                    <td>
                                        <span class="fw-semibold">
                                            @project.Title
                                        </span>
                                    </td>


                                    <!-- Short Description -->
                                    <td>
                                        <span class="text-muted project-description">
                                            @project.ShortDescription
                                        </span>
                                    </td>


                                    <!-- Actions -->
                                    <td>
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            <a class="btn btn-sm btn-outline-info"
                                               asp-action="Details"
                                               asp-route-id="@project.Id">
                                                <i class="bi bi-eye"></i>
                                                جزئیات
                                            </a>

                                            <a class="btn btn-sm btn-outline-warning"
                                               asp-action="Update"
                                               asp-route-id="@project.Id">
                                                <i class="bi bi-pencil-square"></i>
                                                ویرایش
                                            </a>

                                            <a class="btn btn-sm btn-outline-danger"
                                               asp-action="Delete"
                                               asp-route-id="@project.Id">
                                                <i class="bi bi-trash"></i>
                                                حذف
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5">

                    <i class="bi bi-folder-x fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        پروژه‌ای وجود ندارد
                    </h5>

                    <p class="text-muted mb-3">
                        هنوز هیچ پروژه‌ای ثبت نشده است.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-success">
                        <i class="bi bi-plus-lg"></i>
                        افزودن اولین پروژه
                    </a>

                </div>
            }

        </div>

    </div>

</div>