@using AliMartinCv.Core.ViewModels.Project
@model CreateProjectDto

@{
    Layout = "/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .project-form-container {
        max-width: 850px;
        margin: 40px auto;
    }

    .project-form-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    }

    .project-form-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .project-form-subtitle {
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 30px;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 10px;
        padding: 11px 14px;
        border: 1px solid #dee2e6;
        transition: all 0.2s ease;
    }

        .form-control:focus {
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
            border-color: #86b7fe;
        }

    textarea.form-control {
        min-height: 160px;
        resize: vertical;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .thumbnail-input {
        padding: 9px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }

        .form-actions .btn {
            min-width: 110px;
            border-radius: 9px;
            padding: 9px 20px;
        }

    .validation-summary-errors {
        background: #fff3f3;
        border: 1px solid #f5c2c7;
        color: #842029;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .field-validation-error {
        display: block;
        margin-top: 6px;
        font-size: 0.85rem;
        color: #dc3545;
    }

    @@media (max-width: 768px) {
        .project-form-container {
            margin: 20px 10px;
        }

        .project-form-card {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

            .form-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="container">

    <div class="project-form-container">

        <div class="project-form-card">

            <div class="project-form-title">
                افزودن پروژه جدید
            </div>

            <div class="project-form-subtitle">
                اطلاعات پروژه را وارد کرده و سپس ذخیره کنید.
            </div>

            <form method="post"
                  asp-action="Create"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"></div>

                <div class="form-group">
                    <label asp-for="Title" class="form-label">
                        نام پروژه
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="مثلاً سامانه مدیریت مدرسه" />

                    <span asp-validation-for="Title"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ShortDescription" class="form-label">
                        توضیحات کوتاه
                    </label>

                    <input asp-for="ShortDescription"
                           class="form-control"
                           placeholder="توضیح کوتاهی درباره پروژه وارد کنید" />

                    <span asp-validation-for="ShortDescription"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="form-label">
                        توضیحات کامل
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              placeholder="توضیحات کامل پروژه را وارد کنید"></textarea>

                    <span asp-validation-for="Description"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Slug" class="form-label">
                        اسلاگ
                    </label>

                    <input asp-for="Slug"
                           class="form-control"
                           dir="ltr"
                           placeholder="example-project" />

                    <span asp-validation-for="Slug"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Thumbnail" class="form-label">
                        تصویر پروژه
                    </label>

                    <input asp-for="Thumbnail"
                           type="file"
                           class="form-control thumbnail-input"
                           accept="image/png,image/jpeg,image/webp" />

                    <span asp-validation-for="Thumbnail"></span>
                </div>

                <div class="form-actions">

                    <button type="submit"
                            class="btn btn-success">
                        ذخیره پروژه
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        انصراف
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>