@using AliMartinCv.Core.ViewModels.ArticleGroupViewModels
@model IEnumerable<ArticleGroupDto>
@{
    Layout = "/areas/admin/views/shared/_Layout.cshtml";
}
@{
    if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <p>@TempData["Error"]</p>
        </div>
    }
}

@{
    if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            <p>@TempData["Message"]</p>
        </div>
    }
}
@section _Nav {
    <div class="page-heading">
        <div>
            <div class="page-kicker">لایه‌ی مدیریت</div>
            <h1 class="page-title">مدیریت گروه ها</h1>
            <p class="page-subtitle">ساخت و ویرایش گروه ها</p>
        </div>
        <div class="page-actions">
            <a asp-controller="ArticleGroup" asp-action="Create" class="btn btn-outline-success col-1 btn btn-outline-success col-1  px-5"><i class="fa fa-plus" aria-hidden="true"></i></a>
        </div>
    </div>
}

<table class="table">
    <thead class="thead-dark">
        <tr>
            <th scope="col">نام گروه</th>
            <th scope="col">زیر گروه</th>
            <th scope="col">عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var articleGroup in Model.Where(ag => ag.ParentId == null))
        {
            <tr>
                <td>@articleGroup.Title</td>
                <td>
                    @foreach (var child in Model.Where(cg => cg.ParentId == articleGroup.Id))
                    {
                        <p>@child.Title</p>
                        <a asp-controller="ArticleGroup" asp-action="Detail" asp-route-id="@child.Id" class="btn btn-sm btn-outline-primary"><i class="fa fa-info-circle" aria-hidden="true"></i></a>
                        <a asp-controller="ArticleGroup" asp-action="Edit" asp-route-id="@child.Id" class="btn btn-sm btn-outline-warning"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                        <a asp-controller="ArticleGroup" asp-action="Delete" asp-route-id="@child.Id" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash" aria-hidden="true"></i></a>
                    }
                </td>
                <td>
                    <a asp-controller="ArticleGroup" asp-action="Detail" asp-route-id="@articleGroup.Id" class="btn btn-sm btn-outline-primary"><i class="fa fa-info-circle" aria-hidden="true"></i></a>
                    <a asp-controller="ArticleGroup" asp-action="Edit" asp-route-id="@articleGroup.Id" class="btn btn-sm btn-outline-warning"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                    <a asp-controller="ArticleGroup" asp-action="Delete" asp-route-id="@articleGroup.Id" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash" aria-hidden="true"></i></a>
                </td>
            </tr>
        }

    </tbody>
</table>

