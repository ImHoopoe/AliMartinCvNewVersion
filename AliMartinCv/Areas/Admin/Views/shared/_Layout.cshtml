

<!doctype html>
<html lang="fa" dir="rtl" data-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="googlebot" content="noindex, nofollow, noarchive">
    <meta name="description" content="قالب لایه مدیریت فارسی با Bootstrap 5.2">
    <title>لایه مدیریت | پنل مدیریت</title>

    <!-- Design contract: quiet admin chrome, one cyan action color, lime status accent, 12/18/28px radii. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Vazir primary; Vazirmatn remains a graceful fallback if the CDN is unavailable. -->
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/font-face.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
            :root {
                --bg: #080b14;
                --bg-soft: #0d1220;
                --panel: #111827;
                --panel-strong: #151f31;
                --line: rgba(226, 232, 240, .13);
                --line-strong: rgba(103, 232, 249, .28);
                --text: #f8fafc;
                --muted: #a7b3c7;
                --subtle: #71809a;
                --accent: #67e8f9;
                --accent-strong: #22d3ee;
                --accent-soft: rgba(34, 211, 238, .12);
                --lime: #bef264;
                --success: #4ade80;
                --warning: #fbbf24;
                --danger: #fb7185;
                --radius-sm: 12px;
                --radius-md: 18px;
                --radius-lg: 28px;
                --sidebar-width: 276px;
                --topbar-height: 76px;
                --shadow: 0 24px 80px rgba(0, 0, 0, .28);
                --ease: cubic-bezier(.22, 1, .36, 1);
            }

            html[data-theme="light"] {
                --bg: #f4f8fb;
                --bg-soft: #edf5f8;
                --panel: #ffffff;
                --panel-strong: #eef7fa;
                --line: #dbe8ee;
                --line-strong: rgba(8, 145, 178, .28);
                --text: #0f172a;
                --muted: #5f6f83;
                --subtle: #8090a3;
                --accent: #0891b2;
                --accent-strong: #06b6d4;
                --accent-soft: rgba(6, 182, 212, .1);
                --lime: #65a30d;
                --success: #16a34a;
                --warning: #d97706;
                --danger: #e11d48;
                --shadow: 0 18px 48px rgba(15, 23, 42, .08);
            }

            * {
                box-sizing: border-box;
                scrollbar-width: thin;
                scrollbar-color: var(--accent-strong) var(--bg-soft);
            }

                *::-webkit-scrollbar {
                    width: 11px;
                    height: 11px;
                }

                *::-webkit-scrollbar-track {
                    background: var(--bg-soft);
                    border-inline-start: 1px solid var(--line);
                }

                *::-webkit-scrollbar-thumb {
                    min-height: 42px;
                    border: 3px solid var(--bg-soft);
                    border-radius: 999px;
                    background: linear-gradient( 180deg, var(--accent), var(--accent-strong) 58%, var(--lime) );
                    box-shadow: 0 0 0 1px rgba(103, 232, 249, .18);
                }

                    *::-webkit-scrollbar-thumb:hover {
                        background: linear-gradient( 180deg, #cffafe, var(--accent), var(--lime) );
                    }

                *::-webkit-scrollbar-corner {
                    background: var(--bg);
                }

            html {
                scroll-behavior: smooth;
            }

            body {
                min-width: 320px;
                margin: 0;
                background: radial-gradient( circle at 12% 0%, rgba(34, 211, 238, .08), transparent 28rem ), radial-gradient( circle at 100% 58%, rgba(190, 242, 100, .045), transparent 24rem ), var(--bg);
                color: var(--text);
                font-family: "Vazir", "Vazirmatn", Tahoma, sans-serif;
                line-height: 1.7;
                overflow-x: hidden;
                transition: background-color .25s ease, color .25s ease;
            }

            body,
            button,
            input {
                font-family: inherit;
            }

            button,
            a {
                -webkit-tap-highlight-color: transparent;
            }

            button {
                cursor: pointer;
            }

            a {
                color: inherit;
            }

            :focus-visible {
                outline: 3px solid var(--accent);
                outline-offset: 3px;
            }

            .skip-link {
                position: fixed;
                inset-block-start: -4rem;
                inset-inline-start: 1rem;
                z-index: 2000;
                border-radius: 10px;
                padding: .7rem 1rem;
                background: var(--accent);
                color: #06202a;
                font-weight: 800;
                text-decoration: none;
                transition: inset-block-start .2s ease;
            }

                .skip-link:focus {
                    inset-block-start: 1rem;
                }

            .page-loader {
                position: fixed;
                inset: 0;
                z-index: 3000;
                display: grid;
                place-items: center;
                background: var(--bg);
                transition: opacity .35s ease, visibility .35s ease;
            }

                .page-loader.is-ready {
                    opacity: 0;
                    visibility: hidden;
                    pointer-events: none;
                }

            .loader-mark {
                display: grid;
                place-items: center;
                gap: .85rem;
                color: var(--muted);
                font-size: .78rem;
            }

            .loader-ring {
                width: 52px;
                height: 52px;
                border: 3px solid color-mix( in srgb, var(--accent) 18%, transparent );
                border-top-color: var(--accent);
                border-left-color: var(--lime);
                border-radius: 50%;
                animation: spin .8s linear infinite;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            /*
              =========================
              Admin Layout
              =========================
              */

            .admin-shell {
                --sidebar-width: 276px;
                min-height: 100vh;
                display: grid;
                /*
                  در RTL ستون اول سمت راست قرار می‌گیرد.
                  بنابراین Sidebar باید ستون اول باشد.
                */
                grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
                grid-template-areas: "sidebar main";
                transition: grid-template-columns .3s var(--ease);
            }

                .admin-shell.sidebar-collapsed {
                    --sidebar-width: 88px;
                }

            .sidebar {
                grid-area: sidebar;
                position: sticky;
                inset-block-start: 0;
                z-index: 1000;
                display: flex;
                min-width: 0;
                height: 100vh;
                flex-direction: column;
                padding: 1.25rem .9rem;
                border-inline-start: 1px solid var(--line);
                background: color-mix( in srgb, var(--bg-soft) 92%, transparent );
                overflow: hidden;
                backdrop-filter: blur(18px);
                transition: width .3s var(--ease), background-color .25s ease;
            }

                .sidebar::before {
                    content: "";
                    position: absolute;
                    inset-inline-start: -9rem;
                    inset-block-start: 9rem;
                    width: 18rem;
                    height: 18rem;
                    border-radius: 50%;
                    background: rgba(34, 211, 238, .05);
                    filter: blur(30px);
                    pointer-events: none;
                }

            .sidebar__brand {
                position: relative;
                display: flex;
                min-height: 49px;
                align-items: center;
                gap: .75rem;
                padding: .2rem .45rem 1.15rem;
                border-bottom: 1px solid var(--line);
                color: var(--text);
                text-decoration: none;
                white-space: nowrap;
            }

            .brand-mark {
                display: grid;
                width: 38px;
                height: 38px;
                flex: 0 0 auto;
                place-items: center;
                border-radius: 13px;
                background: var(--accent);
                color: #06202a;
                box-shadow: 0 8px 22px rgba(34, 211, 238, .22);
                font-size: .95rem;
            }

            .brand-copy {
                min-width: 0;
                transition: opacity .2s ease, transform .2s ease;
            }

                .brand-copy strong {
                    display: block;
                    font-size: .98rem;
                    font-weight: 800;
                    letter-spacing: -.02em;
                }

                .brand-copy span {
                    display: block;
                    color: var(--subtle);
                    font-size: .68rem;
                }

            .sidebar__section-label {
                margin: 1.4rem .6rem .55rem;
                color: var(--subtle);
                font-size: .68rem;
                font-weight: 800;
                letter-spacing: .1em;
                white-space: nowrap;
                transition: opacity .2s ease;
            }

            .sidebar__nav {
                position: relative;
                display: grid;
                gap: .35rem;
            }

            .nav-link-admin {
                display: flex;
                min-height: 46px;
                align-items: center;
                gap: .8rem;
                padding: .65rem .72rem;
                border: 1px solid transparent;
                border-radius: var(--radius-sm);
                color: var(--muted);
                font-size: .86rem;
                font-weight: 600;
                text-decoration: none;
                white-space: nowrap;
                transition: color .2s ease, background-color .2s ease, border-color .2s ease, transform .2s ease;
            }

                .nav-link-admin i {
                    width: 22px;
                    flex: 0 0 22px;
                    color: var(--subtle);
                    text-align: center;
                    font-size: .98rem;
                    transition: color .2s ease;
                }

                .nav-link-admin:hover {
                    color: var(--text);
                    background: rgba(255, 255, 255, .045);
                    border-color: var(--line);
                    transform: translateX(-2px);
                }

                .nav-link-admin.active {
                    color: var(--text);
                    background: var(--accent-soft);
                    border-color: rgba(103, 232, 249, .2);
                    box-shadow: inset -3px 0 0 var(--accent);
                }

                    .nav-link-admin.active i {
                        color: var(--accent);
                    }

            .nav-link-admin__text {
                transition: opacity .2s ease;
            }

            .sidebar__footer {
                position: relative;
                display: grid;
                gap: .85rem;
                margin-top: auto;
            }

            .sidebar__profile {
                display: flex;
                align-items: center;
                gap: .7rem;
                padding: .75rem .65rem;
                border: 1px solid var(--line);
                border-radius: var(--radius-md);
                background: rgba(255, 255, 255, .025);
                white-space: nowrap;
            }

            .profile-avatar {
                display: grid;
                width: 36px;
                height: 36px;
                flex: 0 0 auto;
                place-items: center;
                border-radius: 50%;
                background: linear-gradient(145deg, var(--accent), var(--lime));
                color: #06202a;
                font-weight: 800;
            }

            .profile-copy {
                min-width: 0;
                transition: opacity .2s ease;
            }

                .profile-copy strong,
                .profile-copy span {
                    display: block;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }

                .profile-copy strong {
                    color: var(--text);
                    font-size: .78rem;
                }

                .profile-copy span {
                    color: var(--subtle);
                    font-size: .66rem;
                }

            /*
              =========================
              Collapsed Sidebar
              =========================
              */

            .sidebar-collapsed .brand-copy,
            .sidebar-collapsed .profile-copy {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                opacity: 0;
                pointer-events: none;
            }

            .sidebar-collapsed .sidebar__section-label,
            .sidebar-collapsed .nav-link-admin__text {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                opacity: 0;
                pointer-events: none;
            }

            .sidebar-collapsed .sidebar__brand {
                justify-content: center;
                padding-inline: 0;
            }

            .sidebar-collapsed .nav-link-admin {
                justify-content: center;
                padding-inline: 0;
            }

            .sidebar-collapsed .sidebar__profile {
                justify-content: center;
                padding-inline: 0;
            }

            /*
              =========================
              Main Area
              =========================
              */

            .main-area {
                grid-area: main;
                min-width: 0;
            }

            .topbar {
                position: sticky;
                inset-block-start: 0;
                z-index: 900;
                min-height: var(--topbar-height);
                display: flex;
                align-items: center;
                gap: .85rem;
                padding: .9rem clamp(1rem, 3vw, 2.1rem);
                border-bottom: 1px solid var(--line);
                background: color-mix( in srgb, var(--bg) 84%, transparent );
                backdrop-filter: blur(18px);
            }

            .icon-button {
                display: inline-grid;
                width: 42px;
                height: 42px;
                flex: 0 0 42px;
                place-items: center;
                border: 1px solid var(--line);
                border-radius: 12px;
                background: rgba(255, 255, 255, .035);
                color: var(--muted);
                transition: color .2s ease, background-color .2s ease, border-color .2s ease, transform .2s ease;
            }

                .icon-button:hover {
                    color: var(--text);
                    border-color: var(--line-strong);
                    background: var(--accent-soft);
                    transform: translateY(-1px);
                }

            .topbar__toggle i {
                transition: transform .25s var(--ease);
            }

            .sidebar-collapsed .topbar__toggle i {
                transform: rotate(180deg);
            }

            .breadcrumb-admin {
                min-width: 0;
                margin: 0;
                padding: 0;
                color: var(--subtle);
                font-size: .76rem;
            }

                .breadcrumb-admin
                .breadcrumb-item + .breadcrumb-item::before {
                    color: var(--subtle);
                }

                .breadcrumb-admin .breadcrumb-item.active {
                    color: var(--text);
                    font-weight: 700;
                }

            .topbar__spacer {
                flex: 1 1 auto;
            }

            .search-shell {
                position: relative;
                width: min(270px, 30vw);
            }

                .search-shell i {
                    position: absolute;
                    inset-inline-end: .8rem;
                    inset-block-start: 50%;
                    color: var(--subtle);
                    transform: translateY(-50%);
                    pointer-events: none;
                }

                .search-shell input {
                    width: 100%;
                    height: 42px;
                    padding: .6rem 2.25rem .6rem .8rem;
                    border: 1px solid var(--line);
                    border-radius: 12px;
                    background: rgba(255, 255, 255, .035);
                    color: var(--text);
                    font-size: .76rem;
                }

                    .search-shell input::placeholder {
                        color: var(--subtle);
                    }

                    .search-shell input:focus {
                        border-color: var(--line-strong);
                        outline: 0;
                        box-shadow: 0 0 0 4px var(--accent-soft);
                    }

            .notif-wrap {
                position: relative;
            }

            .notif-dot {
                position: absolute;
                inset-block-start: 7px;
                inset-inline-start: 8px;
                width: 7px;
                height: 7px;
                border: 2px solid var(--bg);
                border-radius: 50%;
                background: var(--danger);
            }

            /*
              =========================
              Content
              =========================
              */

            .content {
                width: min(100%, 1440px);
                margin-inline: auto;
                padding: clamp(1.2rem, 3vw, 2.4rem);
            }

            .page-heading {
                display: flex;
                flex-wrap: wrap;
                align-items: flex-end;
                justify-content: space-between;
                gap: 1rem;
                margin-bottom: 1.6rem;
            }

            .page-actions {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: .6rem;
            }

            .page-kicker {
                display: flex;
                align-items: center;
                gap: .5rem;
                margin-bottom: .45rem;
                color: var(--accent);
                font-size: .72rem;
                font-weight: 800;
                letter-spacing: .07em;
            }

                .page-kicker::before {
                    content: "";
                    width: 22px;
                    height: 1px;
                    background: var(--accent);
                }

            .page-title {
                margin: 0;
                color: var(--text);
                font-size: clamp(1.55rem, 2.6vw, 2.25rem);
                font-weight: 800;
                letter-spacing: -.045em;
            }

            .page-subtitle {
                margin: .3rem 0 0;
                color: var(--muted);
                font-size: .82rem;
            }

            .btn-admin {
                display: inline-flex;
                min-height: 42px;
                align-items: center;
                justify-content: center;
                gap: .5rem;
                padding: .65rem 1rem;
                border: 1px solid transparent;
                border-radius: 11px;
                font-size: .78rem;
                font-weight: 700;
                text-decoration: none;
                transition: transform .2s ease, background-color .2s ease, border-color .2s ease;
            }

                .btn-admin:hover {
                    transform: translateY(-1px);
                }

            .btn-primary-admin {
                background: var(--accent);
                color: #06202a;
                box-shadow: 0 7px 18px rgba(34, 211, 238, .15);
            }

                .btn-primary-admin:hover {
                    background: #a5f3fc;
                    color: #06202a;
                }

            .btn-outline-admin {
                border-color: var(--line);
                background: rgba(255, 255, 255, .025);
                color: var(--text);
            }

                .btn-outline-admin:hover {
                    border-color: var(--line-strong);
                    background: var(--accent-soft);
                }

            /*
              =========================
              Panels
              =========================
              */

            .panel {
                border: 1px solid var(--line);
                border-radius: var(--radius-md);
                background: color-mix( in srgb, var(--panel) 92%, transparent );
                box-shadow: 0 12px 38px rgba(0, 0, 0, .06);
            }

            .panel__header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 1.1rem 1.25rem;
                border-bottom: 1px solid var(--line);
            }

            .panel__title {
                margin: 0;
                color: var(--text);
                font-size: .92rem;
                font-weight: 800;
            }

            .panel__meta {
                color: var(--subtle);
                font-size: .72rem;
            }

            .panel__body {
                padding: 1.25rem;
            }

            /*
              =========================
              Skeleton
              =========================
              */


            [hidden] {
                display: none !important;
            }


            /*
              =========================
              View Slot
              =========================
              */

            .view-slot {
                min-height: 420px;
                display: grid;
                place-items: center;
                border: 1px dashed var(--line-strong);
                border-radius: var(--radius-lg);
                background: linear-gradient( 145deg, color-mix(in srgb, var(--panel) 92%, transparent), color-mix(in srgb, var(--panel-strong) 50%, transparent) );
            }

            .view-slot__inner {
                width: min(100%, 420px);
                padding: 2rem 1.25rem;
                text-align: center;
            }

            .view-slot__icon {
                display: grid;
                width: 56px;
                height: 56px;
                margin: 0 auto 1rem;
                place-items: center;
                border: 1px solid var(--line-strong);
                border-radius: 18px;
                background: var(--accent-soft);
                color: var(--accent);
                font-size: 1.25rem;
            }

            .view-slot h2 {
                margin: 0 0 .55rem;
                font-size: 1.08rem;
                font-weight: 800;
            }

            .view-slot p {
                margin: 0;
                color: var(--muted);
                font-size: .78rem;
            }

            /*
              =========================
              Utility Cards
              =========================
              */

            .utility-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 1rem;
                margin-bottom: 1rem;
            }

            .utility-card {
                min-height: 120px;
                padding: 1.1rem 1.15rem;
            }

            .utility-card__top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: .8rem;
                margin-bottom: 1rem;
            }

            .utility-card__icon {
                display: grid;
                width: 36px;
                height: 36px;
                place-items: center;
                border-radius: 11px;
                background: var(--accent-soft);
                color: var(--accent);
            }

            .utility-card__hint {
                width: 40px;
            }

            .utility-card__value {
                width: 55%;
                height: 1rem;
                margin-bottom: .55rem;
            }

            .test-card__value {
                display: block;
                margin-bottom: .12rem;
                color: var(--text);
                font-size: 1.45rem;
                font-weight: 800;
                letter-spacing: -.04em;
            }

            .test-card__label {
                color: var(--muted);
                font-size: .72rem;
            }

            .test-card__trend {
                display: inline-flex;
                align-items: center;
                gap: .3rem;
                color: var(--success);
                font-size: .68rem;
                font-weight: 700;
            }

            /*
              =========================
              Tables and Activities
              =========================
              */

            .skeleton-layout {
                display: grid;
                grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr);
                gap: 1rem;
                margin-bottom: 1rem;
            }

            .skeleton-table {
                min-height: 280px;
            }

            .skeleton-table__row {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 110px 80px;
                align-items: center;
                gap: 1rem;
                padding: .95rem 0;
                border-bottom: 1px solid var(--line);
            }

                .skeleton-table__row:last-child {
                    border-bottom: 0;
                }

            .activity-list {
                display: grid;
                gap: .9rem;
            }

            .activity-row {
                display: flex;
                align-items: center;
                gap: .75rem;
            }

            .activity-avatar {
                width: 34px;
                height: 34px;
                flex: 0 0 34px;
                border-radius: 50%;
            }

            .activity-copy {
                display: grid;
                gap: .38rem;
                width: 100%;
            }

            .test-table {
                width: 100%;
                margin: 0;
                color: var(--muted);
                font-size: .74rem;
                vertical-align: middle;
            }

                .test-table th {
                    padding: .2rem .35rem .75rem;
                    border-bottom: 1px solid var(--line);
                    color: var(--subtle);
                    font-size: .68rem;
                    font-weight: 700;
                }

                .test-table td {
                    padding: .8rem .35rem;
                    border-bottom: 1px solid var(--line);
                }

                .test-table tr:last-child td {
                    border-bottom: 0;
                }

            .test-user {
                display: flex;
                align-items: center;
                gap: .55rem;
                color: var(--text);
                font-weight: 700;
                white-space: nowrap;
            }

            .test-user__avatar {
                display: grid;
                width: 30px;
                height: 30px;
                flex: 0 0 30px;
                place-items: center;
                border-radius: 50%;
                background: var(--accent-soft);
                color: var(--accent);
                font-size: .68rem;
            }

            .test-status {
                display: inline-flex;
                align-items: center;
                gap: .35rem;
                padding: .2rem .5rem;
                border-radius: 999px;
                background: rgba(74, 222, 128, .1);
                color: var(--success);
                font-size: .66rem;
                font-weight: 700;
                white-space: nowrap;
            }

                .test-status::before {
                    content: "";
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: currentColor;
                }

                .test-status.is-draft {
                    background: rgba(251, 191, 36, .1);
                    color: var(--warning);
                }

            .test-activity__time {
                color: var(--subtle);
                font-size: .66rem;
            }

            /*
              =========================
              Footer and Dropdown
              =========================
              */

            .admin-footer {
                padding: 1.2rem 0 .4rem;
                color: var(--subtle);
                font-size: .7rem;
                text-align: center;
            }

            .mobile-sidebar-backdrop {
                display: none;
            }

            .dropdown-menu {
                min-width: 190px;
                padding: .45rem;
                border: 1px solid var(--line);
                border-radius: 14px;
                background: var(--panel);
                box-shadow: var(--shadow);
            }

            .dropdown-item {
                border-radius: 9px;
                color: var(--muted);
                font-size: .76rem;
            }

                .dropdown-item:hover,
                .dropdown-item:focus {
                    background: var(--accent-soft);
                    color: var(--text);
                }

            .dropdown-divider {
                border-color: var(--line);
            }

            /*
              =========================
              Responsive
              =========================
              */

            @@media (max-width: 1199.98px) {
                .utility-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }

                .search-shell {
                    width: min(230px, 28vw);
                }
            }

            /*
                از md به بالا Sidebar در سمت راست باقی می‌ماند.
                فقط زیر md به offcanvas تبدیل می‌شود.
              */
            @@media (max-width: 767.98px) {
                .admin-shell,
                .admin-shell.sidebar-collapsed {
                    display: block;
                }

                .sidebar {
                    position: fixed;
                    inset: 0 0 0 auto;
                    width: min(88vw, 300px);
                    height: 100dvh;
                    transform: translateX(105%);
                    box-shadow: -18px 0 50px rgba(0, 0, 0, .25);
                    transition: transform .3s var(--ease);
                }

                .sidebar-open .sidebar {
                    transform: translateX(0);
                }

                .sidebar-collapsed .brand-copy,
                .sidebar-collapsed .sidebar__section-label,
                .sidebar-collapsed .nav-link-admin__text,
                .sidebar-collapsed .profile-copy {
                    position: static;
                    width: auto;
                    height: auto;
                    overflow: visible;
                    opacity: 1;
                    pointer-events: auto;
                }

                .sidebar-collapsed .sidebar__brand {
                    justify-content: flex-start;
                    padding-inline: .45rem;
                }

                .sidebar-collapsed .nav-link-admin {
                    justify-content: flex-start;
                    padding-inline: .72rem;
                }

                .sidebar-collapsed .sidebar__profile {
                    justify-content: flex-start;
                    padding-inline: .65rem;
                }

                .mobile-sidebar-backdrop {
                    position: fixed;
                    inset: 0;
                    z-index: 950;
                    display: block;
                    background: rgba(8, 11, 20, .58);
                    opacity: 0;
                    visibility: hidden;
                    transition: opacity .25s ease, visibility .25s ease;
                }

                .sidebar-open .mobile-sidebar-backdrop {
                    opacity: 1;
                    visibility: visible;
                }

                .main-area {
                    min-height: 100vh;
                }

                .topbar {
                    min-height: 68px;
                }

                .search-shell {
                    width: min(270px, 34vw);
                }

                .skeleton-layout {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 575.98px) {
                .content {
                    padding: 1rem;
                }

                .topbar {
                    gap: .55rem;
                    padding-inline: 1rem;
                }

                .breadcrumb-admin {
                    display: none;
                }

                .search-shell {
                    display: none;
                }

                .topbar__spacer {
                    min-width: .25rem;
                }

                .icon-button {
                    width: 40px;
                    height: 40px;
                    flex-basis: 40px;
                }

                .page-heading {
                    align-items: stretch;
                    margin-bottom: 1.15rem;
                }

                .page-actions {
                    width: 100%;
                }

                    .page-actions .btn-admin {
                        flex: 1 1 0;
                    }

                .utility-grid {
                    grid-template-columns: 1fr;
                    gap: .75rem;
                }

                .utility-card {
                    min-height: 110px;
                }

                .panel__header,
                .panel__body {
                    padding: 1rem;
                }

                .view-slot {
                    min-height: 340px;
                }

                .skeleton-table__row {
                    grid-template-columns: minmax(0, 1fr) 70px;
                }

                    .skeleton-table__row .skeleton-line:last-child {
                        display: none;
                    }
            }

            @@media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    scroll-behavior: auto !important;
                    animation-duration: .001ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: .001ms !important;
                }
            }
    </style>
</head>
<body>
    <a class="skip-link" href="#main-content">پرش به محتوای اصلی</a>

    <div class="page-loader" id="pageLoader" aria-label="در حال بارگذاری" role="status">
        <div class="loader-mark">
            <span class="loader-ring" aria-hidden="true"></span>
            <span>در حال آماده‌سازی پنل</span>
        </div>
    </div>

    <div class="admin-shell" id="adminShell">
        <aside class="sidebar" id="adminSidebar" aria-label="ناوبری اصلی">
            <a class="sidebar__brand" href="#" aria-label="صفحه اصلی پنل مدیریت">
                <span class="brand-mark" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></span>
                <span class="brand-copy">
                    <strong>پنل مدیریت</strong>
                    <span>Ali Martin UI System</span>
                </span>
            </a>

            <div class="sidebar__section-label">ناوبری</div>
            <nav class="sidebar__nav" aria-label="منوی مدیریت">
                <a class="nav-link-admin active" href="#view-slot" aria-current="page" title="نمای کلی">
                    <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
                    <span class="nav-link-admin__text">نمای کلی</span>
                </a>
                <a class="nav-link-admin" asp-action="Index" asp-area="Admin" asp-controller="ArticleGroup" title="گروه‌های مقاله">
                    <i class="fa-solid fa-folder-tree" aria-hidden="true"></i>
                    <span class="nav-link-admin__text">گروه‌های مقاله</span>
                </a>
                <a class="nav-link-admin" asp-action="Index" asp-area="Admin" asp-controller="Articles" title="مقالات">
                    <i class="fa-solid fa-newspaper" aria-hidden="true"></i>
                    <span class="nav-link-admin__text">مقالات</span>
                </a>
                <a class="nav-link-admin" href="#users" title="کاربران">
                    <i class="fa-solid fa-users" aria-hidden="true"></i>
                    <span class="nav-link-admin__text">کاربران</span>
                </a>
                <a class="nav-link-admin" asp-action="Index" asp-area="Admin" asp-controller="Projects" title="پروژه‌ها">
                    <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                    <span class="nav-link-admin__text">پروژه‌ها</span>
                </a>
            </nav>

            <div class="sidebar__footer">
                <div class="sidebar__profile">
                    <span class="profile-avatar" aria-hidden="true">ع</span>
                    <span class="profile-copy">
                        <strong>علی مارتین</strong>
                        <span>مدیر سیستم</span>
                    </span>
                </div>
            </div>
        </aside>

        <div class="mobile-sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

        <div class="main-area">
            <header class="topbar">
                <button class="icon-button topbar__toggle" type="button" data-sidebar-toggle aria-label="جمع کردن نوار کناری" aria-controls="adminSidebar" aria-expanded="true" title="جمع کردن نوار کناری">
                    <i class="fa-solid fa-angles-right" aria-hidden="true"></i>
                </button>

                <nav aria-label="مسیر صفحه">
                    <ol class="breadcrumb breadcrumb-admin">
                        <li class="breadcrumb-item">پنل مدیریت</li>
                        <li class="breadcrumb-item active" aria-current="page">نمای کلی</li>
                    </ol>
                </nav>

                <div class="topbar__spacer"></div>

                <label class="search-shell" aria-label="جست‌وجو در پنل">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input type="search" placeholder="جست‌وجو..." autocomplete="off">
                </label>

                <div class="notif-wrap">
                    <button class="icon-button" type="button" aria-label="اعلان‌ها" title="اعلان‌ها">
                        <i class="fa-regular fa-bell" aria-hidden="true"></i>
                    </button>
                    <span class="notif-dot" aria-hidden="true"></span>
                </div>

                <button class="icon-button" type="button" data-theme-toggle aria-label="تغییر حالت نمایش" title="تغییر حالت نمایش">
                    <i class="fa-solid fa-sun" data-theme-icon aria-hidden="true"></i>
                </button>

                <div class="dropdown">
                    <button class="icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="منوی حساب کاربری" title="حساب کاربری">
                        <i class="fa-solid fa-user" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-start text-end">
                        <li><a class="dropdown-item" href="#profile"><i class="fa-regular fa-id-card ms-2" aria-hidden="true"></i>پروفایل من</a></li>
                        <li><a class="dropdown-item" href="#settings"><i class="fa-solid fa-gear ms-2" aria-hidden="true"></i>تنظیمات</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#logout"><i class="fa-solid fa-arrow-right-from-bracket ms-2" aria-hidden="true"></i>خروج</a></li>
                    </ul>
                </div>
            </header>

            <main class="content" id="main-content">
                
                @await RenderSectionAsync("_Nav",false)
                <!-- Reusable layout-only loading preview; replace with View content when wiring the backend. -->
                @await RenderSectionAsync("_adminComponents", false)

                <section class="view-slot" id="view-slot" data-view-slot aria-label="محل قرارگیری View">
                    @RenderBody()
                </section>

                <footer class="admin-footer">ساخته‌شده با سیستم طراحی Ali Martin · Bootstrap 5.2</footer>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            (() => {
                const root = document.documentElement;
                const shell = document.getElementById('adminShell');
                const loader = document.getElementById('pageLoader');
                const backdrop = document.getElementById('sidebarBackdrop');
                const sidebarToggle = document.querySelector('[data-sidebar-toggle]');
                const themeToggle = document.querySelector('[data-theme-toggle]');
                const themeIcon = document.querySelector('[data-theme-icon]');
                const skeletonToggle = document.querySelector('[data-skeleton-toggle]');
                const skeletonToggleText = document.querySelector('[data-skeleton-toggle-text]');
                const skeletonBlocks = [...document.querySelectorAll('[data-skeleton-content]')];
                const testBlocks = [...document.querySelectorAll('[data-test-content]')];
                const storage = {
                    theme: 'ali-admin-theme',
                    sidebar: 'ali-admin-sidebar-collapsed'
                };

                const setTheme = (theme) => {
                    root.dataset.theme = theme;
                    themeIcon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
                    themeToggle.setAttribute('aria-label', theme === 'dark' ? 'فعال کردن حالت روشن' : 'فعال کردن حالت شب');
                    themeToggle.setAttribute('title', theme === 'dark' ? 'حالت روشن' : 'حالت شب');
                };

                const setDesktopSidebar = (collapsed) => {
                    shell.classList.toggle('sidebar-collapsed', collapsed);
                    sidebarToggle.setAttribute('aria-expanded', String(!collapsed));
                    sidebarToggle.setAttribute('aria-label', collapsed ? 'باز کردن نوار کناری' : 'جمع کردن نوار کناری');
                    sidebarToggle.setAttribute('title', collapsed ? 'باز کردن نوار کناری' : 'جمع کردن نوار کناری');
                };

                const closeMobileSidebar = () => shell.classList.remove('sidebar-open');

                let isSkeletonVisible = false;

                const storedTheme = localStorage.getItem(storage.theme) || 'dark';
                const storedSidebar = localStorage.getItem(storage.sidebar) === 'true';
                setTheme(storedTheme);
                setDesktopSidebar(storedSidebar);

                themeToggle.addEventListener('click', () => {
                    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
                    setTheme(nextTheme);
                    localStorage.setItem(storage.theme, nextTheme);
                });

                sidebarToggle.addEventListener('click', () => {
                    if (window.matchMedia('(max-width: 991.98px)').matches) {
                        shell.classList.toggle('sidebar-open');
                        return;
                    }
                    const collapsed = !shell.classList.contains('sidebar-collapsed');
                    setDesktopSidebar(collapsed);
                    localStorage.setItem(storage.sidebar, String(collapsed));
                });

                backdrop.addEventListener('click', closeMobileSidebar);
                document.querySelectorAll('.nav-link-admin').forEach((link) => {
                    link.addEventListener('click', () => {
                        document.querySelectorAll('.nav-link-admin').forEach((item) => item.classList.remove('active'));
                        link.classList.add('active');
                        closeMobileSidebar();
                    });
                });

                window.addEventListener('resize', () => {
                    if (!window.matchMedia('(max-width: 991.98px)').matches) closeMobileSidebar();
                });

                window.addEventListener('load', () => {
                    window.setTimeout(() => loader.classList.add('is-ready'), 420);
                    window.setTimeout(() => setContentState(false), 1500);
                });
            })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
