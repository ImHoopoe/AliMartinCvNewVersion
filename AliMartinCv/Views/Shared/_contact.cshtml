<section id="contact">
    <div class="container">
        <div class="section-head" data-reveal>
            <p class="section-kicker">Let’s work together</p>
            <h2 class="section-title">Have a project in mind?</h2>
            <p class="section-lead">Tell me what you’re building, where it feels stuck and what a good outcome looks like.</p>
        </div>
        <div class="contact-grid">
            <article class="panel" data-reveal>
                <h3>Get in touch</h3>
                <p>I’m open to product work, technical mentoring and conversations about building better software.</p>
                <div class="contact-list">
                    <div class="contact-item"><span class="contact-icon"></span><div><small>Email</small><a href="mailto:Alimartin8203@gmail.com">Alimartin8203@gmail.com</a></div></div>
                    <div class="contact-item"><span class="contact-icon">⌖</span><div><small>Location</small><span>Tehran, Iran</span></div></div>
                    <div class="contact-item"><span class="contact-icon">+98</span><div><small>Phone</small><a href="tel:+989216026354">+98 921 602 6354</a></div></div>
                </div>
                <div class="socials"><a class="social" href="https://github.com/ImHoopoe" target="_blank" rel="noopener noreferrer">GitHub</a><a class="social" href="https://www.linkedin.com/in/ali-martin-imhoopoe" target="_blank" rel="noopener noreferrer">LinkedIn</a><a class="social" href="https://x.com/imHoopoe" target="_blank" rel="noopener noreferrer">X</a><a class="social" href="https://www.instagram.com/alimartintheprogrammer/" target="_blank" rel="noopener noreferrer">Instagram</a></div>
            </article>
            <div class="panel" data-reveal>
                <form id="contactForm" novalidate>
                    <div class="form-grid">
                        <div class="field"><label for="name">Your name</label><input id="name" name="name" type="text" autocomplete="name" placeholder="e.g. Sara Ahmadi" required></div>
                        <div class="field"><label for="email">Your email</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required></div>
                        <div class="field full"><label for="subject">Subject</label><input id="subject" name="subject" type="text" placeholder="What would you like to build?"></div>
                        <div class="field full"><label for="message">Your message</label><textarea id="message" name="message" placeholder="A little context helps me give you a useful reply." required></textarea></div>
                    </div>
                    <div class="form-footer"><button class="btn btn-primary" type="submit">Send message <span aria-hidden="true">→</span></button><span class="form-status" id="formStatus" role="status" hidden>Thanks — the form is ready to connect to your backend.</span></div>
                </form>
            </div>
        </div>
    </div>
</section>