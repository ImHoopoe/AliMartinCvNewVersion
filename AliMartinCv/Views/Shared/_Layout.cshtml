


<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Ali Martin — Full Stack Developer, .NET specialist and programming instructor.">
  <title>Ali Martin — Full Stack Developer &amp; Instructor</title>
  <style>
    :root {
      --bg: #080b14;
      --bg-soft: #0d1220;
      --panel: #111827;
      --panel-strong: #151f31;
      --line: rgba(226, 232, 240, .13);
      --text: #f8fafc;
      --muted: #a7b3c7;
      --subtle: #71809a;
      --accent: #67e8f9;
      --accent-strong: #22d3ee;
      --accent-soft: rgba(34, 211, 238, .12);
      --lime: #bef264;
      --success: #4ade80;
      --warning: #fbbf24;
      --danger: #fb7185;
      --radius-sm: 12px;
      --radius-md: 18px;
      --radius-lg: 28px;
      --shadow: 0 24px 80px rgba(0, 0, 0, .28);
      --max: 1160px;
    }

    * {
      box-sizing: border-box;
      scrollbar-width: thin;
      scrollbar-color: var(--accent-strong) rgba(13, 18, 32, .92);
    }

    *::-webkit-scrollbar { width: 11px; height: 11px; }
    *::-webkit-scrollbar-track { background: rgba(8, 11, 20, .92); border-left: 1px solid rgba(103, 232, 249, .08); }
    *::-webkit-scrollbar-thumb {
      min-height: 42px;
      border: 3px solid rgba(8, 11, 20, .92);
      border-radius: 999px;
      background: linear-gradient(180deg, var(--accent), var(--accent-strong) 58%, var(--lime));
      box-shadow: 0 0 0 1px rgba(103, 232, 249, .18), 0 0 14px rgba(34, 211, 238, .18);
    }
    *::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, #cffafe, var(--accent), var(--lime));
      box-shadow: 0 0 0 1px rgba(190, 242, 100, .36), 0 0 18px rgba(34, 211, 238, .28);
    }
    *::-webkit-scrollbar-corner { background: var(--bg); }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      position: relative;
      background:
        radial-gradient(circle at 90% 4%, rgba(34, 211, 238, .10), transparent 28rem),
        radial-gradient(circle at 0% 38%, rgba(190, 242, 100, .05), transparent 26rem),
        var(--bg);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
    }

    main, footer { position: relative; z-index: 1; }

    .galaxy-backdrop {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      background: radial-gradient(circle at 50% -12%, rgba(42, 69, 112, .24), transparent 34rem);
    }

    .galaxy-backdrop::before,
    .galaxy-backdrop::after {
      content: "";
      position: absolute;
      inset: -35%;
      background-repeat: repeat;
      pointer-events: none;
    }

    .galaxy-backdrop::before {
      background-image:
        radial-gradient(1px 1px at 18px 24px, rgba(255, 255, 255, .78), transparent 1.6px),
        radial-gradient(1px 1px at 86px 138px, rgba(103, 232, 249, .68), transparent 1.6px),
        radial-gradient(1.4px 1.4px at 162px 52px, rgba(255, 255, 255, .54), transparent 1.8px),
        radial-gradient(1px 1px at 244px 194px, rgba(190, 242, 100, .56), transparent 1.7px);
      background-size: 280px 230px;
      opacity: .24;
      animation: starfield-drift 100s linear infinite;
    }

    .galaxy-backdrop::after {
      background-image:
        radial-gradient(1px 1px at 44px 72px, rgba(255, 255, 255, .4), transparent 1.5px),
        radial-gradient(1px 1px at 128px 32px, rgba(103, 232, 249, .42), transparent 1.5px),
        radial-gradient(1px 1px at 210px 166px, rgba(255, 255, 255, .32), transparent 1.5px);
      background-size: 320px 270px;
      opacity: .16;
      transform: scale(1.25);
      animation: starfield-drift-reverse 145s linear infinite;
    }

    .galaxy-nebula {
      position: absolute;
      width: 34rem;
      aspect-ratio: 1;
      border-radius: 50%;
      filter: blur(30px);
      opacity: .42;
    }

    .nebula-a {
      top: 7%;
      left: -14rem;
      background: radial-gradient(circle, rgba(34, 211, 238, .15), rgba(34, 211, 238, 0) 68%);
      animation: nebula-float-a 34s ease-in-out infinite alternate;
    }

    .nebula-b {
      right: -17rem;
      top: 42%;
      background: radial-gradient(circle, rgba(99, 102, 241, .18), rgba(99, 102, 241, 0) 68%);
      animation: nebula-float-b 42s ease-in-out infinite alternate;
    }

    .galaxy-orbit {
      position: absolute;
      width: 48rem;
      height: 18rem;
      border: 1px solid rgba(103, 232, 249, .09);
      border-radius: 50%;
      transform: rotate(-24deg);
    }

    .orbit-a { right: -17rem; top: 14%; }
    .orbit-b { left: -20rem; bottom: 12%; transform: rotate(28deg); border-color: rgba(190, 242, 100, .06); }

    @@keyframes starfield-drift { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-80px, 140px, 0); } }
    @@keyframes starfield-drift-reverse { from { transform: scale(1.25) translate3d(0, 0, 0); } to { transform: scale(1.25) translate3d(110px, -90px, 0); } }
    @@keyframes nebula-float-a { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(8rem, 5rem, 0) scale(1.16); } }
    @@keyframes nebula-float-b { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(-7rem, -4rem, 0) scale(1.12); } }

    a { color: inherit; }
    button, input, textarea { font: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }
    button { cursor: pointer; }

    :focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 4px;
    }

    .skip-link {
      position: fixed;
      left: 1rem;
      top: -5rem;
      z-index: 100;
      padding: .7rem 1rem;
      background: var(--accent);
      color: #06202a;
      border-radius: 10px;
      font-weight: 800;
    }

    .skip-link:focus { top: 1rem; }

    .container {
      width: min(var(--max), calc(100% - 2.5rem));
      margin-inline: auto;
    }

    .site-header {
      position: fixed;
      inset: 0 0 auto;
      z-index: 50;
      border-bottom: 1px solid transparent;
      transition: background .25s ease, border-color .25s ease, box-shadow .25s ease;
    }

    .site-header.scrolled {
      background: rgba(8, 11, 20, .86);
      border-color: var(--line);
      box-shadow: 0 12px 34px rgba(0, 0, 0, .18);
      backdrop-filter: blur(18px);
    }

    .nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: .7rem;
      color: var(--text);
      text-decoration: none;
      font-weight: 850;
      letter-spacing: -.03em;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 11px;
      background: var(--accent);
      color: #06202a;
      font-size: .82rem;
      letter-spacing: -.08em;
    }

    .brand span:last-child { font-size: 1.08rem; }

    .nav-links {
      display: flex;
      align-items: center;
      gap: .35rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: .45rem .75rem;
      border-radius: 10px;
      color: var(--muted);
      text-decoration: none;
      font-size: .9rem;
      transition: color .2s ease, background .2s ease;
    }

    .nav-link:hover, .nav-link.active {
      color: var(--text);
      background: rgba(255, 255, 255, .06);
    }

    .nav-link.cta {
      margin-left: .45rem;
      padding-inline: 1rem;
      background: var(--accent);
      color: #06202a;
      font-weight: 800;
      box-shadow: 0 4px 12px rgba(34, 211, 238, .16), inset 0 1px 0 rgba(255, 255, 255, .28);
      transition: color .2s ease, background .2s ease, box-shadow .2s ease, transform .2s ease;
    }

    .nav-link.cta:hover {
      background: #a5f3fc;
      box-shadow: 0 7px 18px rgba(34, 211, 238, .22), inset 0 1px 0 rgba(255, 255, 255, .36);
      transform: translateY(-1px);
    }

    .nav-link.cta:active {
      box-shadow: 0 2px 7px rgba(34, 211, 238, .16), inset 0 1px 1px rgba(6, 32, 42, .16);
      transform: translateY(0);
    }

    .nav-link.cta:focus-visible {
      outline: 3px solid rgba(190, 242, 100, .62);
      outline-offset: 3px;
      box-shadow: 0 0 0 5px rgba(103, 232, 249, .14), 0 7px 18px rgba(34, 211, 238, .2);
    }

    .nav-toggle {
      display: none;
      width: 42px;
      height: 42px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: rgba(255, 255, 255, .04);
      color: var(--text);
    }

    .nav-toggle svg { width: 20px; height: 20px; }

    .hero {
      position: relative;
      min-height: 720px;
      display: grid;
      align-items: center;
      padding: 9rem 0 5rem;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 34rem;
      height: 34rem;
      right: -12rem;
      top: 8rem;
      border: 1px solid rgba(103, 232, 249, .14);
      border-radius: 50%;
      box-shadow: 0 0 0 4rem rgba(103, 232, 249, .025), 0 0 0 9rem rgba(103, 232, 249, .02);
      pointer-events: none;
    }

    .hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1.12fr) minmax(320px, .88fr);
      gap: 4rem;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      margin: 0 0 1.4rem;
      color: var(--accent);
      font-size: .78rem;
      font-weight: 850;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 28px;
      height: 1px;
      background: var(--accent);
    }

    .availability {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .42rem .75rem;
      margin-bottom: 1.4rem;
      border: 1px solid rgba(74, 222, 128, .24);
      border-radius: 999px;
      background: rgba(74, 222, 128, .08);
      color: #bbf7d0;
      font-size: .78rem;
      font-weight: 700;
    }

    .availability::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 0 4px rgba(74, 222, 128, .13);
    }

    h1, h2, h3, h4, p { margin-top: 0; }

    .hero-title {
      max-width: 750px;
      margin-bottom: 1.25rem;
      font-size: clamp(3rem, 7vw, 5.7rem);
      line-height: .98;
      letter-spacing: -.075em;
    }

    .hero-title .accent { color: var(--accent); }

    .hero-role {
      min-height: 2.25rem;
      margin-bottom: 1.35rem;
      color: var(--lime);
      font-size: clamp(1.2rem, 2.4vw, 1.65rem);
      font-weight: 700;
      letter-spacing: -.03em;
    }

    .cursor {
      display: inline-block;
      width: 2px;
      height: 1.1em;
      margin-left: .18rem;
      vertical-align: -.12em;
      background: var(--lime);
      animation: blink 1s steps(1) infinite;
    }

    .hero-copy {
      max-width: 610px;
      margin-bottom: 2rem;
      color: var(--muted);
      font-size: 1.06rem;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: .8rem;
      align-items: center;
    }

    .btn {
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .55rem;
      padding: .72rem 1.1rem;
      border: 1px solid transparent;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 800;
      font-size: .92rem;
      transition: transform .2s ease, background .2s ease, border-color .2s ease, color .2s ease;
    }

    .btn:hover { transform: translateY(-2px); }

    .btn-primary { background: var(--accent); color: #06202a; }
    .btn-primary:hover { background: #a5f3fc; }
    .btn-secondary { border-color: var(--line); background: rgba(255, 255, 255, .04); color: var(--text); }
    .btn-secondary:hover { background: rgba(255, 255, 255, .09); border-color: rgba(103, 232, 249, .4); }
    .btn-quiet { border-color: transparent; background: transparent; color: var(--muted); padding-inline: .2rem; }
    .btn-quiet:hover { color: var(--accent); }
    .btn svg { width: 17px; height: 17px; flex: 0 0 auto; }

    .hero-note {
      display: flex;
      gap: .65rem;
      align-items: center;
      margin-top: 1.35rem;
      color: var(--subtle);
      font-size: .84rem;
    }

    .hero-note strong { color: var(--muted); }

    .hero-visual { position: relative; min-height: 460px; }

    .visual-frame {
      position: absolute;
      inset: 2rem 1rem 1rem 2rem;
      display: grid;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 42% 18% 30% 20% / 23% 28% 20% 31%;
      background: linear-gradient(145deg, rgba(21, 31, 49, .96), rgba(9, 15, 27, .98));
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .visual-frame::before {
      content: "";
      position: absolute;
      width: 20rem;
      height: 20rem;
      border: 1px solid rgba(103, 232, 249, .25);
      border-radius: 50%;
      transform: rotate(-25deg) translate(4rem, -2rem);
    }

    .visual-frame::after {
      content: "";
      position: absolute;
      width: 11rem;
      height: 11rem;
      right: -3rem;
      bottom: -2rem;
      border-radius: 50%;
      background: rgba(190, 242, 100, .11);
      filter: blur(24px);
    }

    .portrait {
      position: relative;
      z-index: 1;
      width: min(255px, 64%);
      aspect-ratio: .84;
      display: grid;
      place-items: center;
      border: 1px solid rgba(103, 232, 249, .35);
      border-radius: 45% 45% 28% 28% / 36% 36% 23% 23%;
      overflow: hidden;
      background: linear-gradient(160deg, #1a3343 0%, #111827 60%, #0b101c 100%);
      box-shadow: 0 0 0 10px rgba(103, 232, 249, .04), 0 28px 60px rgba(0, 0, 0, .38);
    }

    .portrait img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      filter: saturate(.92) contrast(1.04);
    }

    .portrait-mark {
      position: relative;
      z-index: 2;
      align-self: end;
      margin-bottom: 1.25rem;
      padding: .55rem .75rem;
      border: 1px solid rgba(255, 255, 255, .2);
      border-radius: 999px;
      background: rgba(8, 11, 20, .65);
      backdrop-filter: blur(10px);
      color: rgba(255, 255, 255, .9);
      font-weight: 850;
      letter-spacing: .16em;
      font-size: .74rem;
    }

    .visual-label {
      position: absolute;
      z-index: 2;
      display: grid;
      gap: .1rem;
      padding: .7rem .85rem;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: rgba(8, 11, 20, .76);
      backdrop-filter: blur(14px);
      box-shadow: 0 14px 30px rgba(0, 0, 0, .22);
    }

    .visual-label.top { top: 1rem; right: 0; }
    .visual-label.bottom { bottom: 2rem; left: 0; }
    .visual-label strong { font-size: .9rem; }
    .visual-label span { color: var(--subtle); font-size: .72rem; }

    section { position: relative; padding: 6rem 0; }
    section:nth-of-type(even) { background: rgba(255, 255, 255, .018); }

    .section-head { max-width: 650px; margin-bottom: 2.4rem; }
    .section-head.center { margin-inline: auto; text-align: center; }
    .section-kicker { margin-bottom: .55rem; color: var(--accent); font-size: .77rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
    .section-title { margin-bottom: .8rem; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.06; letter-spacing: -.06em; }
    .section-lead { margin-bottom: 0; color: var(--muted); }

    .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    .stat-card { min-height: 150px; display: flex; flex-direction: column; justify-content: space-between; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgba(255, 255, 255, .035); }
    .stat-card:hover { border-color: rgba(103, 232, 249, .35); }
    .stat-value { display: block; color: var(--text); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 850; letter-spacing: -.06em; }
    .stat-label { color: var(--muted); font-size: .87rem; }

    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .panel { padding: clamp(1.35rem, 3vw, 2rem); border: 1px solid var(--line); border-radius: var(--radius-lg); background: rgba(17, 24, 39, .72); }
    .panel h3 { margin-bottom: .85rem; font-size: 1.35rem; letter-spacing: -.035em; }
    .panel p { color: var(--muted); }
    .panel p:last-child { margin-bottom: 0; }

    .info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
    .info-label { display: block; margin-bottom: .2rem; color: var(--subtle); font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .info-value { color: var(--text); font-size: .9rem; overflow-wrap: anywhere; }
    .ability-list { display: grid; gap: .8rem; margin: 1.25rem 0 0; padding: 0; list-style: none; }
    .ability-list li { display: flex; gap: .7rem; color: var(--muted); }
    .ability-list li::before { content: "✓"; color: var(--lime); font-weight: 900; }

    .skills-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .skill-card { padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgba(17, 24, 39, .72); }
    .skill-card h3 { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.45rem; font-size: 1.08rem; }
    .skill-card h3 span { color: var(--accent); font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .skill-item + .skill-item { margin-top: 1.15rem; }
    .skill-head { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: .45rem; color: var(--muted); font-size: .88rem; }
    .skill-head strong { color: var(--text); font-weight: 700; }
    .skill-track { height: 8px; overflow: hidden; border-radius: 99px; background: rgba(255, 255, 255, .08); }
    .skill-fill { width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--accent-strong), var(--lime)); transition: width 1s cubic-bezier(.22, 1, .36, 1); }

    .timeline { position: relative; display: grid; gap: 1.1rem; }
    .timeline::before { content: ""; position: absolute; top: 1.2rem; bottom: 1.2rem; left: 135px; width: 1px; background: var(--line); }
    .timeline-item { position: relative; display: grid; grid-template-columns: 150px 1fr; gap: 1.8rem; align-items: start; }
    .timeline-date { position: relative; z-index: 1; padding-top: 1.25rem; color: var(--accent); font-size: .78rem; font-weight: 850; letter-spacing: .04em; }
    .timeline-date::after { content: ""; position: absolute; top: 1.35rem; right: 7px; width: 9px; height: 9px; border: 3px solid var(--bg); border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
    .timeline-card { padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgba(17, 24, 39, .72); }
    .timeline-card:hover { border-color: rgba(103, 232, 249, .35); }
    .timeline-card h3 { margin-bottom: .25rem; font-size: 1.25rem; letter-spacing: -.035em; }
    .company { margin-bottom: .85rem; color: var(--lime); font-size: .9rem; font-weight: 700; }
    .timeline-card > p { margin-bottom: 1.25rem; color: var(--muted); }
    .sub-experiences { display: grid; gap: .75rem; padding-top: 1rem; border-top: 1px solid var(--line); }
    .sub-experience { display: grid; grid-template-columns: 34px 1fr; gap: .75rem; padding: .8rem; border: 1px solid rgba(255, 255, 255, .06); border-radius: 12px; background: rgba(255, 255, 255, .025); }
    .sub-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 10px; background: var(--accent-soft); color: var(--accent); font-size: .78rem; font-weight: 850; }
    .sub-experience h4 { margin-bottom: .15rem; font-size: .92rem; }
    .sub-experience p { margin: 0; color: var(--subtle); font-size: .82rem; }
    .tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }
    .tag { padding: .27rem .6rem; border: 1px solid rgba(103, 232, 249, .2); border-radius: 999px; background: var(--accent-soft); color: #c9f8ff; font-size: .73rem; font-weight: 700; }

    .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .project-card { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: rgba(17, 24, 39, .76); }
    .project-card:hover { border-color: rgba(103, 232, 249, .38); }
    .project-art { position: relative; min-height: 240px; overflow: hidden; display: grid; place-items: center; }
    .project-art.samro { background: linear-gradient(140deg, #0d2c43, #0c1727 64%, #1d3945); }
    .project-art.avid { background: linear-gradient(140deg, #2a1c42, #131a34 60%, #132d3b); }
    .project-art::before, .project-art::after { content: ""; position: absolute; border: 1px solid rgba(255, 255, 255, .16); transform: rotate(22deg); }
    .project-art::before { width: 16rem; height: 8rem; border-radius: 18px; }
    .project-art::after { width: 10rem; height: 5rem; border-radius: 14px; transform: rotate(-20deg) translate(3rem, 3rem); }
    .art-copy { position: relative; z-index: 1; display: grid; gap: .35rem; place-items: center; }
    .art-copy strong { font-size: clamp(2.1rem, 5vw, 3.2rem); letter-spacing: -.08em; }
    .art-copy span { color: rgba(255, 255, 255, .72); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; }
    .project-status { position: absolute; top: 1rem; left: 1rem; z-index: 2; padding: .35rem .62rem; border-radius: 999px; background: #bbf7d0; color: #0b2b19; font-size: .7rem; font-weight: 850; text-transform: uppercase; }
    .project-status.new { background: #a5f3fc; color: #082a35; }
    .project-body { padding: 1.35rem; }
    .project-topline { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
    .project-topline h3 { margin-bottom: .25rem; font-size: 1.35rem; }
    .project-type { color: var(--accent); font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-align: right; text-transform: uppercase; }
    .project-body p { margin-bottom: 1.15rem; color: var(--muted); font-size: .9rem; }
    .project-actions { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; }

    .filter-bar { display: flex; flex-wrap: wrap; gap: .45rem; margin-bottom: 1.5rem; }
    .filter-btn { padding: .48rem .75rem; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--muted); font-size: .8rem; font-weight: 700; }
    .filter-btn:hover, .filter-btn.active { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
    .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .blog-card { display: flex; flex-direction: column; min-height: 265px; padding: 1.3rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgba(17, 24, 39, .72); }
    .blog-card[hidden] { display: none; }
    .blog-meta { display: flex; justify-content: space-between; gap: .75rem; margin-bottom: 1.3rem; color: var(--subtle); font-size: .75rem; }
    .blog-category { color: var(--accent); font-weight: 800; text-transform: uppercase; }
    .blog-card h3 { margin-bottom: .65rem; font-size: 1.1rem; letter-spacing: -.025em; }
    .blog-card p { color: var(--muted); font-size: .86rem; }
    .blog-card .btn-quiet { margin-top: auto; align-self: flex-start; font-size: .82rem; }

    .skeleton-item { position: relative; overflow: hidden; }
    .skeleton-item > * { transition: opacity .28s ease; }
    .skeleton-item:not(.is-loaded) > * { opacity: 0; pointer-events: none; }
    .skeleton-item:not(.is-loaded)::before,
    .skeleton-item:not(.is-loaded)::after { content: ""; position: absolute; z-index: 4; pointer-events: none; transition: opacity .28s ease, visibility .28s ease; }
    .skeleton-item:not(.is-loaded)::before { inset: 1.25rem; border-radius: 10px; background:
      linear-gradient(rgba(154, 205, 225, .17), rgba(154, 205, 225, .17)) 0 0 / 46% 1rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 0 2.2rem / 82% .7rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 0 3.45rem / 66% .7rem no-repeat; }
    .skeleton-item:not(.is-loaded)::after { inset: 0; background: linear-gradient(110deg, transparent 25%, rgba(165, 243, 252, .13) 48%, transparent 70%); transform: translateX(-100%); animation: skeleton-shimmer 1.35s ease-in-out infinite; }
    .skeleton-item.is-loaded::before,
    .skeleton-item.is-loaded::after { opacity: 0; visibility: hidden; }
    .stat-card.skeleton-item:not(.is-loaded)::before { inset: 1.25rem; background:
      linear-gradient(rgba(154, 205, 225, .17), rgba(154, 205, 225, .17)) 0 0 / 45% 2.35rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 0 100% / 70% .7rem no-repeat; }
    .skill-card.skeleton-item:not(.is-loaded)::before { inset: 1.5rem; background:
      linear-gradient(rgba(154, 205, 225, .17), rgba(154, 205, 225, .17)) 0 0 / 58% 1rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 0 2.25rem / 82% .62rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .12), rgba(154, 205, 225, .12)) 0 3.35rem / 100% .5rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 0 5.2rem / 72% .62rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .12), rgba(154, 205, 225, .12)) 0 6.3rem / 100% .5rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 0 8.15rem / 78% .62rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .12), rgba(154, 205, 225, .12)) 0 9.25rem / 100% .5rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 0 11.1rem / 68% .62rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .12), rgba(154, 205, 225, .12)) 0 12.2rem / 100% .5rem no-repeat; }
    .timeline-item.skeleton-item:not(.is-loaded)::before { inset: 0; border-radius: 0; background:
      linear-gradient(rgba(154, 205, 225, .17), rgba(154, 205, 225, .17)) 0 1.25rem / 105px .75rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .17), rgba(154, 205, 225, .17)) 180px 1.25rem / 42% 1.1rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 180px 3.1rem / 70% .7rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 180px 4.35rem / 82% .7rem no-repeat; }
    .project-card.skeleton-item:not(.is-loaded)::before { inset: 0; border-radius: 0; background:
      linear-gradient(rgba(154, 205, 225, .11), rgba(154, 205, 225, .11)) 0 0 / 100% 45% no-repeat,
      linear-gradient(rgba(154, 205, 225, .17), rgba(154, 205, 225, .17)) 1.35rem calc(45% + 1.35rem) / 38% 1rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 1.35rem calc(45% + 3.1rem) / 84% .7rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 1.35rem calc(45% + 4.35rem) / 66% .7rem no-repeat; }
    .blog-card.skeleton-item:not(.is-loaded)::before { inset: 1.3rem; background:
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 0 0 / 44% .7rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .17), rgba(154, 205, 225, .17)) 0 2.25rem / 78% 1.15rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 0 4.2rem / 100% .7rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .1), rgba(154, 205, 225, .1)) 0 5.45rem / 82% .7rem no-repeat,
      linear-gradient(rgba(154, 205, 225, .14), rgba(154, 205, 225, .14)) 0 calc(100% - .2rem) / 36% 1.9rem no-repeat; }

    @@keyframes skeleton-shimmer { to { transform: translateX(100%); } }

    .contact-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 1rem; align-items: stretch; }
    .contact-list { display: grid; gap: .9rem; margin: 1.6rem 0 0; }
    .contact-item { display: grid; grid-template-columns: 38px 1fr; gap: .75rem; align-items: center; }
    .contact-icon { width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid rgba(103, 232, 249, .2); border-radius: 11px; background: var(--accent-soft); color: var(--accent); font-size: .82rem; font-weight: 900; }
    .contact-item small { display: block; margin-bottom: .12rem; color: var(--subtle); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .contact-item a, .contact-item span { color: var(--text); text-decoration: none; font-size: .88rem; overflow-wrap: anywhere; }
    .socials { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
    .social { min-width: 40px; min-height: 36px; display: inline-grid; place-items: center; padding: 0 .65rem; border: 1px solid var(--line); border-radius: 10px; color: var(--muted); text-decoration: none; font-size: .78rem; font-weight: 800; }
    .social:hover { border-color: var(--accent); color: var(--accent); }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .field { display: grid; gap: .45rem; }
    .field.full { grid-column: 1 / -1; }
    .field label { color: var(--muted); font-size: .8rem; font-weight: 700; }
    .field input, .field textarea { width: 100%; border: 1px solid var(--line); border-radius: 11px; background: rgba(255, 255, 255, .035); color: var(--text); padding: .78rem .85rem; transition: border-color .2s ease, background .2s ease, box-shadow .2s ease; }
    .field textarea { min-height: 135px; resize: vertical; }
    .field input::placeholder, .field textarea::placeholder { color: #64748b; }
    .field input:focus, .field textarea:focus { border-color: var(--accent); outline: 0; background: rgba(255, 255, 255, .06); box-shadow: 0 0 0 4px rgba(103, 232, 249, .1); }
    .form-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1rem; }
    .form-status { color: var(--success); font-size: .82rem; }
    .form-status[hidden] { display: none; }

    dialog { width: min(680px, calc(100% - 2rem)); padding: 0; border: 1px solid rgba(103, 232, 249, .28); border-radius: var(--radius-lg); background: var(--panel); color: var(--text); box-shadow: var(--shadow); }
    dialog::backdrop { background: rgba(2, 6, 23, .78); backdrop-filter: blur(7px); }
    .dialog-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.4rem 1.5rem 1rem; border-bottom: 1px solid var(--line); }
    .dialog-head h2 { margin: 0; font-size: 1.25rem; }
    .dialog-close { width: 34px; height: 34px; border: 1px solid var(--line); border-radius: 10px; background: transparent; color: var(--muted); font-size: 1.2rem; line-height: 1; }
    .dialog-close:hover { color: var(--text); border-color: var(--accent); }
    .dialog-body { padding: 1.5rem; color: var(--muted); }
    .dialog-body h3 { color: var(--text); font-size: 1rem; }
    .dialog-body ul { padding-left: 1.1rem; }
    .dialog-body li + li { margin-top: .45rem; }
    .dialog-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.3rem; }
    .cv-file-dialog { width: min(920px, calc(100% - 2rem)); }
    .cv-viewer { height: min(70vh, 720px); min-height: 480px; overflow: auto; display: grid; place-items: start center; padding: 1rem; background: #0b1120; }
    .cv-viewer img { display: block; width: min(100%, 680px); height: auto; border-radius: 8px; box-shadow: 0 18px 40px rgba(0, 0, 0, .32); }
    .cv-file-dialog > .dialog-actions { padding: 0 1.5rem 1.5rem; }

    footer { padding: 2rem 0; border-top: 1px solid var(--line); color: var(--subtle); font-size: .82rem; }
    .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
    .footer-inner p { margin: 0; }

    [data-reveal] { opacity: 0; transform: translateY(16px); transition: opacity .65s ease, transform .65s ease; }
    [data-reveal].is-visible { opacity: 1; transform: none; }

    @@keyframes blink { 50% { opacity: 0; } }

    @@media (max-width: 900px) {
      .nav-toggle { display: grid; place-items: center; }
      .nav-links { position: absolute; inset: 76px 1.25rem auto; display: none; flex-direction: column; align-items: stretch; gap: .2rem; padding: .7rem; border: 1px solid var(--line); border-radius: 16px; background: rgba(13, 18, 32, .98); box-shadow: var(--shadow); }
      .nav-links.open { display: flex; }
      .nav-link { justify-content: center; min-height: 44px; }
      .nav-link.cta { margin: .35rem 0 0; }
      .hero-grid { grid-template-columns: 1fr; gap: 1rem; }
      .hero { min-height: auto; padding-top: 8.5rem; }
      .hero-copy { margin-inline: auto; }
      .hero-visual { min-height: 390px; max-width: 520px; width: 100%; margin: 1rem auto 0; }
      .visual-frame { inset: 1rem 2rem 1rem 2rem; }
      .stat-grid { grid-template-columns: repeat(2, 1fr); }
      .timeline::before { left: 8px; }
      .timeline-item { grid-template-columns: 1fr; gap: .55rem; padding-left: 2rem; }
      .timeline-date { padding-top: 0; }
      .timeline-date::after { top: .25rem; left: -2rem; right: auto; }
    }

    @@media (max-width: 680px) {
      .container { width: min(var(--max), calc(100% - 1.5rem)); }
      section { padding: 4.5rem 0; }
      .hero { padding-bottom: 3rem; }
      .hero-title { font-size: clamp(2.8rem, 14vw, 4.5rem); }
      .actions, .actions .btn { width: 100%; }
      .hero-note { align-items: flex-start; }
      .hero-visual { order: -1; min-height: 345px; margin: 0 auto 1rem; }
      .visual-frame { inset: 1rem .8rem .8rem; }
      .visual-label.bottom { left: .2rem; }
      .visual-label.top { right: .2rem; }
      .about-grid, .skills-grid, .project-grid, .contact-grid { grid-template-columns: 1fr; }
      .info-grid, .form-grid { grid-template-columns: 1fr; }
      .field.full { grid-column: auto; }
      .blog-grid { grid-template-columns: 1fr; }
      .project-topline { display: block; }
      .project-type { display: block; margin-top: .35rem; text-align: left; }
      .form-footer { align-items: stretch; }
      .form-footer .btn { width: 100%; }
      .cv-viewer { height: 68vh; min-height: 420px; }
    }

    @@media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
      [data-reveal] { opacity: 1; transform: none; }
      .nav-link.cta:hover, .nav-link.cta:active { transform: none; }
    }
    .blog-card img {
    width: 100%;
    max-width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    margin : 20px auto;
}
  </style>
</head>
<body>
