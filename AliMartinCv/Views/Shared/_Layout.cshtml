      <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
  <script>
    (() => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const header = document.getElementById('siteHeader');
      const navToggle = document.querySelector('.nav-toggle');
      const navLinks = document.getElementById('navLinks');

      const closeMenu = () => {
        navLinks.classList.remove('open');
        navToggle.setAttribute('aria-expanded', 'false');
        navToggle.setAttribute('aria-label', 'Open navigation');
      };

      navToggle.addEventListener('click', () => {
        const open = navLinks.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      });

      document.querySelectorAll('.nav-link[href^="#"]').forEach(link => link.addEventListener('click', closeMenu));
      window.addEventListener('scroll', () => header.classList.toggle('scrolled', window.scrollY > 12), { passive: true });

      const revealTargets = document.querySelectorAll('[data-reveal]');
      const reveal = item => item.classList.add('is-visible');
      if (reducedMotion || !('IntersectionObserver' in window)) revealTargets.forEach(reveal);
      else {
        const revealObserver = new IntersectionObserver(entries => entries.forEach(entry => {
          if (entry.isIntersecting) { reveal(entry.target); revealObserver.unobserve(entry.target); }
        }), { threshold: .12 });
        revealTargets.forEach(item => revealObserver.observe(item));
      }

      const skeletonItems = document.querySelectorAll('.skeleton-item');
      const finishSkeleton = item => {
        item.classList.add('is-loaded');
        item.setAttribute('aria-busy', 'false');
      };
      skeletonItems.forEach(item => item.setAttribute('aria-busy', 'true'));
      if (reducedMotion || !('IntersectionObserver' in window)) skeletonItems.forEach(finishSkeleton);
      else {
        const skeletonObserver = new IntersectionObserver(entries => entries.forEach(entry => {
          if (entry.isIntersecting) {
            window.setTimeout(() => finishSkeleton(entry.target), 420);
            skeletonObserver.unobserve(entry.target);
          }
        }), { threshold: .08 });
        skeletonItems.forEach(item => skeletonObserver.observe(item));
      }

      const typedText = document.getElementById('typedText');
      const roles = ['Full Stack Developer', 'Software Programming Instructor', 'C# & .NET Specialist', 'UI/UX Enthusiast', 'Mentor & Code Reviewer'];
      let roleIndex = 0, charIndex = roles[0].length, deleting = true;
      const typeRole = () => {
        if (reducedMotion) { typedText.textContent = roles[0]; return; }
        const role = roles[roleIndex];
        typedText.textContent = role.slice(0, charIndex);
        if (deleting) charIndex -= 1; else charIndex += 1;
        if (charIndex === 0) { deleting = false; roleIndex = (roleIndex + 1) % roles.length; }
        if (charIndex === roles[roleIndex].length && !deleting) deleting = true;
        window.setTimeout(typeRole, deleting ? 55 : 92);
      };
      if (!reducedMotion) window.setTimeout(typeRole, 1300);

      const formatNumber = value => new Intl.NumberFormat('en-US').format(value);
      const animateCounter = counter => {
        const target = Number(counter.dataset.count);
        const suffix = counter.dataset.suffix || '';
        if (reducedMotion) { counter.textContent = formatNumber(target) + suffix; return; }
        const start = performance.now();
        const duration = 1200;
        const frame = now => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          counter.textContent = formatNumber(Math.round(target * eased)) + suffix;
          if (progress < 1) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      };

      const counters = document.querySelectorAll('[data-count]');
      const skills = document.querySelectorAll('.skill-fill');
      let metricsStarted = false;
      const startMetrics = () => {
        if (metricsStarted) return;
        metricsStarted = true;
        counters.forEach(animateCounter);
        skills.forEach(skill => { const value = Number(skill.dataset.value); skill.style.width = value + '%'; skill.setAttribute('aria-valuenow', String(value)); });
      };
      const metricsBlock = document.querySelector('.stat-grid');
      if (reducedMotion || !('IntersectionObserver' in window)) startMetrics();
      else new IntersectionObserver(entries => { if (entries.some(entry => entry.isIntersecting)) startMetrics(); }, { threshold: .3 }).observe(metricsBlock);

      const sectionLinks = [...document.querySelectorAll('.nav-link[href^="#"]')];
      const sections = [...document.querySelectorAll('main section[id]')];
      const sectionObserver = new IntersectionObserver(entries => entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        sectionLinks.forEach(link => link.classList.toggle('active', link.getAttribute('href') === '#' + entry.target.id));
      }), { rootMargin: '-35% 0px -55% 0px', threshold: 0 });
      sections.forEach(section => sectionObserver.observe(section));

      const projectData = {
        samro: { title: 'Samro', intro: 'A comprehensive system for managing sports events, ticketing and player registration.', items: ['ASP.NET / .NET Core application structure', 'Operational workflows for sports events', 'SQL Server-backed registration and data management'], link: 'https://samro.ir' },
        avid3d: { title: 'Avid3D', intro: 'An interactive platform for 3D modeling services and creative digital designs.', items: ['Blazor-based product experience', 'Three.js-oriented 3D presentation layer', 'Clear service discovery and project communication'], link: 'https://avid3d.ir' }
      };
      const projectDialog = document.getElementById('projectDialog');
      document.querySelectorAll('[data-project]').forEach(button => button.addEventListener('click', () => {
        const data = projectData[button.dataset.project];
        document.getElementById('projectDialogTitle').textContent = data.title;
        document.getElementById('projectDialogIntro').textContent = data.intro;
        document.getElementById('projectDialogList').innerHTML = data.items.map(item => '<li>' + item + '</li>').join('');
        document.getElementById('projectDialogLink').href = data.link;
        projectDialog.showModal();
      }));

      const cvPdfDataUrl = 'data:application/pdf;base64,';
      const cvBinary = atob(cvPdfDataUrl.split(',')[1]);
      const cvBytes = Uint8Array.from(cvBinary, character => character.charCodeAt(0));
      const cvBlobUrl = URL.createObjectURL(new Blob([cvBytes], { type: 'application/pdf' }));
      document.getElementById('cvDownloadLink').href = cvBlobUrl;
      document.querySelectorAll('[data-open-dialog]').forEach(button => button.addEventListener('click', () => document.getElementById(button.dataset.openDialog).showModal()));
      document.querySelectorAll('[data-close-dialog]').forEach(button => button.addEventListener('click', () => button.closest('dialog').close()));
      document.querySelectorAll('dialog').forEach(dialog => dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); }));

      document.querySelectorAll('[data-filter]').forEach(filter => filter.addEventListener('click', () => {
        const value = filter.dataset.filter;
        document.querySelectorAll('[data-filter]').forEach(item => item.classList.toggle('active', item === filter));
        document.querySelectorAll('.blog-card').forEach(card => { card.hidden = value !== 'all' && card.dataset.category !== value; });
      }));

      const articleDialog = document.getElementById('articleDialog');
      document.querySelectorAll('[data-article]').forEach(button => button.addEventListener('click', () => {
        document.getElementById('articleDialogBody').textContent = button.dataset.article;
        articleDialog.showModal();
      }));

      const form = document.getElementById('contactForm');
      const status = document.getElementById('formStatus');
      form.addEventListener('submit', event => {
        event.preventDefault();
        if (!form.checkValidity()) { form.reportValidity(); return; }
        status.hidden = false;
        form.reset();
      });

      document.getElementById('year').textContent = new Date().getFullYear();
    })();
  </script>
</body>
</html>
